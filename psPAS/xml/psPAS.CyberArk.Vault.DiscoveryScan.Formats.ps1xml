<?xml version="1.0" encoding="utf-8"?>
<Configuration>
	<ViewDefinitions>
		<View>
			<Name>psPAS.CyberArk.Vault.DiscoveryScan</Name>
			<ViewSelectedBy>
				<TypeName>psPAS.CyberArk.Vault.DiscoveryScan</TypeName>
			</ViewSelectedBy>
			<TableControl>
				<TableHeaders>
					<TableColumnHeader />
					<TableColumnHeader />
					<TableColumnHeader />
					<TableColumnHeader />
					<TableColumnHeader />
				</TableHeaders>
				<TableRowEntries>
					<TableRowEntry>
						<TableColumnItems>
							<TableColumnItem>
								<PropertyName>taskId</PropertyName>
							</TableColumnItem>
							<TableColumnItem>
								<PropertyName>discoveryName</PropertyName>
							</TableColumnItem>
							<TableColumnItem>
								<PropertyName>discoveryType</PropertyName>
							</TableColumnItem>
							<TableColumnItem>
								<PropertyName>scanStatus</PropertyName>
							</TableColumnItem>
							<TableColumnItem>
								<PropertyName>runningMode</PropertyName>
							</TableColumnItem>
						</TableColumnItems>
					</TableRowEntry>
				</TableRowEntries>
			</TableControl>
		</View>
		<View>
			<Name>psPAS.CyberArk.Vault.DiscoveryScan</Name>
			<ViewSelectedBy>
				<TypeName>psPAS.CyberArk.Vault.DiscoveryScan</TypeName>
			</ViewSelectedBy>
			<ListControl>
				<ListEntries>
					<ListEntry>
						<ListItems>
							<ListItem>
								<PropertyName>taskId</PropertyName>
							</ListItem>
							<ListItem>
								<PropertyName>discoveryName</PropertyName>
							</ListItem>
							<ListItem>
								<PropertyName>discoveryType</PropertyName>
							</ListItem>
							<ListItem>
								<PropertyName>creationDate</PropertyName>
							</ListItem>
							<ListItem>
								<PropertyName>createdBy</PropertyName>
							</ListItem>
							<ListItem>
								<PropertyName>managingScanner</PropertyName>
							</ListItem>
							<ListItem>
								<PropertyName>runningMode</PropertyName>
							</ListItem>
							<ListItem>
								<PropertyName>nextScanTime</PropertyName>
							</ListItem>
							<ListItem>
								<PropertyName>scanStatus</PropertyName>
							</ListItem>
							<ListItem>
								<ItemSelectionCondition>
									<ScriptBlock>$_.scheduleInformation</ScriptBlock>
								</ItemSelectionCondition>
								<PropertyName>scheduleInformation</PropertyName>
							</ListItem>
							<ListItem>
								<PropertyName>totalMachines</PropertyName>
							</ListItem>
							<ListItem>
								<PropertyName>scannedMachines</PropertyName>
							</ListItem>
							<ListItem>
								<ItemSelectionCondition>
									<ScriptBlock>$_.scanProperties</ScriptBlock>
								</ItemSelectionCondition>
								<PropertyName>scanProperties</PropertyName>
							</ListItem>
						</ListItems>
					</ListEntry>
				</ListEntries>
			</ListControl>
		</View>
	</ViewDefinitions>
</Configuration>
