<?xml version="1.0" encoding="utf-8" ?>
<Configuration>
	<ViewDefinitions>
		<View>
			<Name>psPAS.CyberArk.Vault.OAuthProvider</Name>
			<ViewSelectedBy>
				<TypeName>psPAS.CyberArk.Vault.OAuthProvider</TypeName>
			</ViewSelectedBy>
			<TableControl>
				<TableHeaders>
					<TableColumnHeader>
						<Label>id</Label>
					</TableColumnHeader>
					<TableColumnHeader>
						<Label>accessTokenValidationMode</Label>
					</TableColumnHeader>
					<TableColumnHeader>
						<Label>signatureValidationMode</Label>
					</TableColumnHeader>
					<TableColumnHeader>
						<Label>issuerUrl</Label>
					</TableColumnHeader>
					<TableColumnHeader>
						<Label>audience</Label>
					</TableColumnHeader>
					<TableColumnHeader>
						<Label>allowedUsers</Label>
					</TableColumnHeader>
				</TableHeaders>
				<TableRowEntries>
					<TableRowEntry>
						<TableColumnItems>
							<TableColumnItem>
								<PropertyName>id</PropertyName>
							</TableColumnItem>
							<TableColumnItem>
								<PropertyName>accessTokenValidationMode</PropertyName>
							</TableColumnItem>
							<TableColumnItem>
								<PropertyName>signatureValidationMode</PropertyName>
							</TableColumnItem>
							<TableColumnItem>
								<PropertyName>issuerUrl</PropertyName>
							</TableColumnItem>
							<TableColumnItem>
								<PropertyName>audience</PropertyName>
							</TableColumnItem>
							<TableColumnItem>
								<ScriptBlock>
									if ($null -ne $_.allowedUsers) { "$(@($_.allowedUsers).Count) user(s)" } else { $null }
								</ScriptBlock>
							</TableColumnItem>
						</TableColumnItems>
					</TableRowEntry>
				</TableRowEntries>
			</TableControl>
		</View>
		<View>
			<Name>psPAS.CyberArk.Vault.OAuthProvider</Name>
			<ViewSelectedBy>
				<TypeName>psPAS.CyberArk.Vault.OAuthProvider</TypeName>
			</ViewSelectedBy>
			<ListControl>
				<ListEntries>
					<ListEntry>
						<ListItems>
							<ListItem>
								<PropertyName>id</PropertyName>
							</ListItem>
							<ListItem>
								<PropertyName>accessTokenValidationMode</PropertyName>
							</ListItem>
							<ListItem>
								<PropertyName>signatureValidationMode</PropertyName>
							</ListItem>
							<ListItem>
								<PropertyName>publicKey</PropertyName>
							</ListItem>
							<ListItem>
								<PropertyName>issuerUrl</PropertyName>
							</ListItem>
							<ListItem>
								<PropertyName>allowedUsers</PropertyName>
							</ListItem>
							<ListItem>
								<PropertyName>audience</PropertyName>
							</ListItem>
							<ListItem>
								<PropertyName>clientCredentials</PropertyName>
							</ListItem>
							<ListItem>
								<PropertyName>clientIdClaimType</PropertyName>
							</ListItem>
						</ListItems>
					</ListEntry>
				</ListEntries>
			</ListControl>
		</View>
	</ViewDefinitions>
</Configuration>
