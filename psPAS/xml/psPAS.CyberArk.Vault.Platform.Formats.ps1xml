<?xml version="1.0" encoding="utf-8"?>
<Configuration>
	<ViewDefinitions>
	<View>
			<Name>psPAS.CyberArk.Vault.Platform.RotationalGroups</Name>
			<ViewSelectedBy>
				<TypeName>psPAS.CyberArk.Vault.Platform.RotationalGroups</TypeName>
			</ViewSelectedBy>
			<TableControl>
				<TableHeaders>
					<TableColumnHeader>
						<Label>PlatformID</Label>
						<Width>20</Width>
					</TableColumnHeader>
					<TableColumnHeader>
						<Label>ID</Label>
						<Width>4</Width>
					</TableColumnHeader>
					<TableColumnHeader>
						<Label>Active</Label>
						<Width>7</Width>
					</TableColumnHeader>
					<TableColumnHeader>
						<Label>Name</Label>
						<Width>30</Width>
					</TableColumnHeader>
					<TableColumnHeader>
						<Label>GracePeriod</Label>
						<Width>11</Width>
					</TableColumnHeader>
				</TableHeaders>
				<TableRowEntries>
					<TableRowEntry>
						<TableColumnItems>
							<TableColumnItem>
								<ScriptBlock>
									if ($_.PSObject.Properties.Match('PlatformID').Count) { $_.PlatformID } else { $_.general.id }
								</ScriptBlock>
							</TableColumnItem>
							<TableColumnItem>
								<PropertyName>ID</PropertyName>
							</TableColumnItem>
							<TableColumnItem>
								<ScriptBlock>
									if ($_.PSObject.Properties.Match('Active').Count) { $_.Active } else { $_.general.active }
								</ScriptBlock>
							</TableColumnItem>
							<TableColumnItem>
								<ScriptBlock>
									if ($_.PSObject.Properties.Match('Name').Count) { $_.Name } else { $_.general.name }
								</ScriptBlock>
							</TableColumnItem>
							<TableColumnItem>
								<PropertyName>GracePeriod</PropertyName>
							</TableColumnItem>
						</TableColumnItems>
					</TableRowEntry>
				</TableRowEntries>
			</TableControl>
		</View>
			<View>
			<Name>psPAS.CyberArk.Vault.Platform.Dependents</Name>
			<ViewSelectedBy>
				<TypeName>psPAS.CyberArk.Vault.Platform.Dependents</TypeName>
			</ViewSelectedBy>
			<TableControl>
				<TableHeaders>
					<TableColumnHeader>
						<Label>PlatformID</Label>
						<Width>20</Width>
					</TableColumnHeader>
					<TableColumnHeader>
						<Label>ID</Label>
						<Width>4</Width>
					</TableColumnHeader>
					<TableColumnHeader>
						<Label>Name</Label>
						<Width>30</Width>
					</TableColumnHeader>
					<TableColumnHeader>
						<Label>NumberOfLinkedTargetPlatforms</Label>
						<Width>29</Width>
					</TableColumnHeader>
				</TableHeaders>
				<TableRowEntries>
					<TableRowEntry>
						<TableColumnItems>
							<TableColumnItem>
								<PropertyName>PlatformID</PropertyName>
							</TableColumnItem>
							<TableColumnItem>
								<PropertyName>ID</PropertyName>
							</TableColumnItem>
							<TableColumnItem>
								<PropertyName>Name</PropertyName>
							</TableColumnItem>
							<TableColumnItem>
								<PropertyName>NumberOfLinkedTargetPlatforms</PropertyName>
							</TableColumnItem>
						</TableColumnItems>
					</TableRowEntry>
				</TableRowEntries>
			</TableControl>
		</View>
		<View>
			<Name>psPAS.CyberArk.Vault.Platform.Basic</Name>
			<ViewSelectedBy>
				<TypeName>psPAS.CyberArk.Vault.Platform.Basic</TypeName>
			</ViewSelectedBy>
			<TableControl>
			  	<TableHeaders>
						<TableColumnHeader>
							<Label>PlatformID</Label>
							<Width>15</Width>
						</TableColumnHeader>
						<TableColumnHeader>
							<Label>ID</Label>
							<Width>4</Width>
						</TableColumnHeader>
						<TableColumnHeader>
							<Label>Active</Label>
							<Width>7</Width>
						</TableColumnHeader>
						<TableColumnHeader>
							<Label>SystemType</Label>
							<Width>15</Width>
						</TableColumnHeader>
						<TableColumnHeader>
							<Label>Name</Label>
							<Width>25</Width>
						</TableColumnHeader>
						<TableColumnHeader>
							<Label>AllowedSafes</Label>
							<Width>15</Width>
						</TableColumnHeader>
					</TableHeaders>
				<TableRowEntries>
					<TableRowEntry>
						<TableColumnItems>
							<TableColumnItem>
								<ScriptBlock>
									$_.general.id
								</ScriptBlock>
							</TableColumnItem>
							<TableColumnItem>
								<ScriptBlock>
									$_.ID
								</ScriptBlock>
							</TableColumnItem>
							<TableColumnItem>
								<ScriptBlock>
									$_.general.active
								</ScriptBlock>
							</TableColumnItem>
							<TableColumnItem>
								<ScriptBlock>
									$_.general.systemType
								</ScriptBlock>
							</TableColumnItem>
							<TableColumnItem>
								<ScriptBlock>
									$_.general.name
								</ScriptBlock>
							</TableColumnItem>
							<TableColumnItem>
								<ScriptBlock>
									if ($_.AllowedSafes) { $_.AllowedSafes } else { $_.credentialsManagement.allowedSafes }
								</ScriptBlock>
							</TableColumnItem>
						</TableColumnItems>
					</TableRowEntry>
				</TableRowEntries>
			</TableControl>
		</View>
		<View>
			<Name>psPAS.CyberArk.Vault.Platform</Name>
			<ViewSelectedBy>
				<TypeName>psPAS.CyberArk.Vault.Platform.Groups</TypeName>
				<TypeName>psPAS.CyberArk.Vault.Platform.Targets</TypeName>
			</ViewSelectedBy>
			<TableControl>
				<TableHeaders>
				<TableColumnHeader>
					<Label>PlatformID</Label>
					<Width>15</Width>
				</TableColumnHeader>
				<TableColumnHeader>
					<Label>ID</Label>
					<Width>4</Width>
				</TableColumnHeader>
				<TableColumnHeader>
					<Label>Active</Label>
					<Width>7</Width>
				</TableColumnHeader>
				<TableColumnHeader>
					<Label>SystemType</Label>
					<Width>15</Width>
				</TableColumnHeader>
				<TableColumnHeader>
					<Label>Name</Label>
					<Width>25</Width>
				</TableColumnHeader>
				<TableColumnHeader>
					<Label>AllowedSafes</Label>
					<Width>15</Width>
				</TableColumnHeader>
				</TableHeaders>
				<TableRowEntries>
				<TableRowEntry>
					<TableColumnItems>
					<TableColumnItem>
						<PropertyName>PlatformID</PropertyName>
					</TableColumnItem>
					<TableColumnItem>
						<PropertyName>ID</PropertyName>
					</TableColumnItem>
					<TableColumnItem>
						<PropertyName>Active</PropertyName>
					</TableColumnItem>
					<TableColumnItem>
						<ScriptBlock>
							if ($_.SystemType) { $_.SystemType } else { $_.general.systemType }
						</ScriptBlock>
					</TableColumnItem>
					<TableColumnItem>
						<PropertyName>Name</PropertyName>
					</TableColumnItem>
					<TableColumnItem>
						<ScriptBlock>
							if ($_.AllowedSafes) { $_.AllowedSafes } else { $_.credentialsManagement.allowedSafes }
						</ScriptBlock>
					</TableColumnItem>
					</TableColumnItems>
				</TableRowEntry>
				</TableRowEntries>
			</TableControl>
		</View>
		<View>
			<Name>psPAS.CyberArk.Vault.Platform.Details</Name>
			<ViewSelectedBy>
				<TypeName>psPAS.CyberArk.Vault.Platform.Details</TypeName>
			</ViewSelectedBy>
			<TableControl>
				<TableHeaders>
					<TableColumnHeader>
						<Label>PlatformID</Label>
						<Width>20</Width>
					</TableColumnHeader>
					<TableColumnHeader>
						<Label>Active</Label>
						<Width>7</Width>
					</TableColumnHeader>
					<TableColumnHeader>
						<Label>PolicyName</Label>
						<Width>25</Width>
					</TableColumnHeader>
					<TableColumnHeader>
						<Label>AllowManualChange</Label>
						<Width>18</Width>
					</TableColumnHeader>
					<TableColumnHeader>
						<Label>ExeName</Label>
						<Width>25</Width>
					</TableColumnHeader>
				</TableHeaders>
				<TableRowEntries>
					<TableRowEntry>
						<TableColumnItems>
							<TableColumnItem>
								<PropertyName>PlatformID</PropertyName>
							</TableColumnItem>
							<TableColumnItem>
								<PropertyName>Active</PropertyName>
							</TableColumnItem>
							<TableColumnItem>
								<PropertyName>PolicyName</PropertyName>
							</TableColumnItem>
							<TableColumnItem>
								<PropertyName>AllowManualChange</PropertyName>
							</TableColumnItem>
							<TableColumnItem>
								<PropertyName>ExeName</PropertyName>
							</TableColumnItem>
						</TableColumnItems>
					</TableRowEntry>
				</TableRowEntries>
			</TableControl>
		</View>
		<View>
			<Name>psPAS.CyberArk.Vault.Platform.TargetDetails</Name>
			<ViewSelectedBy>
				<TypeName>psPAS.CyberArk.Vault.Platform.TargetDetails</TypeName>
			</ViewSelectedBy>
			<TableControl>
				<TableHeaders>
					<TableColumnHeader>
						<Label>PlatformID</Label>
						<Width>20</Width>
					</TableColumnHeader>
					<TableColumnHeader>
						<Label>Name</Label>
						<Width>25</Width>
					</TableColumnHeader>
					<TableColumnHeader>
						<Label>Status</Label>
						<Width>10</Width>
					</TableColumnHeader>
					<TableColumnHeader>
						<Label>DeviceType</Label>
						<Width>20</Width>
					</TableColumnHeader>
					<TableColumnHeader>
						<Label>PlatformBaseType</Label>
						<Width>18</Width>
					</TableColumnHeader>
				</TableHeaders>
				<TableRowEntries>
					<TableRowEntry>
						<TableColumnItems>
							<TableColumnItem>
								<ScriptBlock>
									$_.general.platformId
								</ScriptBlock>
							</TableColumnItem>
							<TableColumnItem>
								<ScriptBlock>
									$_.general.name
								</ScriptBlock>
							</TableColumnItem>
							<TableColumnItem>
								<ScriptBlock>
									$_.general.status
								</ScriptBlock>
							</TableColumnItem>
							<TableColumnItem>
								<ScriptBlock>
									$_.general.deviceType
								</ScriptBlock>
							</TableColumnItem>
							<TableColumnItem>
								<ScriptBlock>
									$_.general.platformBaseType
								</ScriptBlock>
							</TableColumnItem>
						</TableColumnItems>
					</TableRowEntry>
				</TableRowEntries>
			</TableControl>
		</View>
	</ViewDefinitions>
</Configuration>
