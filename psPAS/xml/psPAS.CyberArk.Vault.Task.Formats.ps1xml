<?xml version="1.0" encoding="utf-8"?>
<Configuration>
	<ViewDefinitions>
		<View>
			<Name>psPAS.CyberArk.Vault.Task</Name>
			<ViewSelectedBy>
				<TypeName>psPAS.CyberArk.Vault.Task</TypeName>
			</ViewSelectedBy>
			<ListControl>
				<ListEntries>
					<ListEntry>
						<ListItems>
							<ListItem>
								<PropertyName>id</PropertyName>
							</ListItem>
							<ListItem>
								<PropertyName>folder</PropertyName>
							</ListItem>
							<ListItem>
								<PropertyName>type</PropertyName>
							</ListItem>
							<ListItem>
								<PropertyName>subType</PropertyName>
							</ListItem>
							<ListItem>
								<PropertyName>name</PropertyName>
							</ListItem>
							<ListItem>
								<PropertyName>keepTaskDefinition</PropertyName>
							</ListItem>
							<ListItem>
								<ItemSelectionCondition>
									<ScriptBlock>$_.schedule.startTime</ScriptBlock>
								</ItemSelectionCondition>
								<Label>schedule.startTime</Label>
								<ScriptBlock>$_.schedule.startTime</ScriptBlock>
							</ListItem>
							<ListItem>
								<ItemSelectionCondition>
									<ScriptBlock>$_.schedule.recurrence.type</ScriptBlock>
								</ItemSelectionCondition>
								<Label>schedule.recurrence.type</Label>
								<ScriptBlock>$_.schedule.recurrence.type</ScriptBlock>
							</ListItem>
							<ListItem>
								<ItemSelectionCondition>
									<ScriptBlock>$_.schedule.recurrence.recurrenceValue</ScriptBlock>
								</ItemSelectionCondition>
								<Label>schedule.recurrence.recurrenceValue</Label>
								<ScriptBlock>$_.schedule.recurrence.recurrenceValue</ScriptBlock>
							</ListItem>
							<ListItem>
								<ItemSelectionCondition>
									<ScriptBlock>$_.schedule.recurrence.daysOfWeek</ScriptBlock>
								</ItemSelectionCondition>
								<Label>schedule.recurrence.daysOfWeek</Label>
								<ScriptBlock>$_.schedule.recurrence.daysOfWeek</ScriptBlock>
							</ListItem>
							<ListItem>
								<ItemSelectionCondition>
									<ScriptBlock>$_.schedule.recurrence.weekNumber</ScriptBlock>
								</ItemSelectionCondition>
								<Label>schedule.recurrence.weekNumber</Label>
								<ScriptBlock>$_.schedule.recurrence.weekNumber</ScriptBlock>
							</ListItem>
							<ListItem>
								<ItemSelectionCondition>
									<ScriptBlock>$_.schedule.lastGenerationDate</ScriptBlock>
								</ItemSelectionCondition>
								<Label>schedule.lastGenerationDate</Label>
								<ScriptBlock>$_.schedule.lastGenerationDate</ScriptBlock>
							</ListItem>
							<ListItem>
								<ItemSelectionCondition>
									<ScriptBlock>$_.subscribers</ScriptBlock>
								</ItemSelectionCondition>
								<PropertyName>subscribers</PropertyName>
							</ListItem>
							<ListItem>
								<ItemSelectionCondition>
									<ScriptBlock>$_.notifyOnFailure</ScriptBlock>
								</ItemSelectionCondition>
								<PropertyName>notifyOnFailure</PropertyName>
							</ListItem>
							<ListItem>
								<ItemSelectionCondition>
									<ScriptBlock>$_.filters</ScriptBlock>
								</ItemSelectionCondition>
								<PropertyName>filters</PropertyName>
							</ListItem>
							<ListItem>
								<ItemSelectionCondition>
									<ScriptBlock>$_.createdAt</ScriptBlock>
								</ItemSelectionCondition>
								<PropertyName>createdAt</PropertyName>
							</ListItem>
							<ListItem>
								<ItemSelectionCondition>
									<ScriptBlock>$_.createdBy</ScriptBlock>
								</ItemSelectionCondition>
								<PropertyName>createdBy</PropertyName>
							</ListItem>
							<ListItem>
								<ItemSelectionCondition>
									<ScriptBlock>$_.lastModifiedAt</ScriptBlock>
								</ItemSelectionCondition>
								<PropertyName>lastModifiedAt</PropertyName>
							</ListItem>
							<ListItem>
								<ItemSelectionCondition>
									<ScriptBlock>$_.lastModifiedBy</ScriptBlock>
								</ItemSelectionCondition>
								<PropertyName>lastModifiedBy</PropertyName>
							</ListItem>
						</ListItems>
					</ListEntry>
				</ListEntries>
			</ListControl>
		</View>
	</ViewDefinitions>
</Configuration>
